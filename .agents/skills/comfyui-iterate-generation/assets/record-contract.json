{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "迭代任务记录结构",
  "description": "按记录类型读取对应 $defs；JSON写入脚本只检查JSON语法，执行Agent核对本合同。",
  "$defs": {
    "criterion": {
      "type": "object",
      "description": "成图判据",
      "properties": {
        "id": {
          "type": "string",
          "description": "判据唯一编号"
        },
        "shot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "适用镜头ID"
          },
          "description": "本判据适用镜头"
        },
        "requirement": {
          "type": "string",
          "description": "需要实现的具体可见结果"
        },
        "evidence": {
          "type": "string",
          "description": "判断通过所需的可见证据"
        },
        "kind": {
          "type": "string",
          "enum": [
            "required",
            "preference"
          ],
          "description": "必需项或偏好项"
        },
        "source": {
          "type": "string",
          "description": "用户锁定原文或确认核心表达的依据"
        }
      },
      "required": [
        "id",
        "shot_ids",
        "requirement",
        "evidence",
        "kind",
        "source"
      ],
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "description": "素材取舍",
      "properties": {
        "name": {
          "type": "string",
          "description": "画面要素"
        },
        "source": {
          "type": "string",
          "description": "材料或创作选择"
        },
        "purpose": {
          "type": "string",
          "description": "表达作用"
        },
        "decision": {
          "type": "string",
          "enum": [
            "preserve",
            "experiment",
            "omit"
          ],
          "description": "保留、可试验、省略"
        },
        "reason": {
          "type": "string",
          "description": "取舍原因"
        },
        "retry_condition": {
          "type": "string",
          "description": "何种变化或证据值得重新试验"
        }
      },
      "required": [
        "name",
        "source",
        "purpose",
        "decision",
        "reason",
        "retry_condition"
      ],
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "description": "逐镜头构图",
      "properties": {
        "id": {
          "type": "string",
          "description": "镜头ID"
        },
        "subject": {
          "type": "string",
          "description": "主要表达对象和视觉关注顺序"
        },
        "space": {
          "type": "string",
          "description": "位置、支撑、接触和遮挡"
        },
        "camera": {
          "type": "string",
          "description": "视角、景别、画幅与裁切"
        },
        "focus": {
          "type": "string",
          "description": "清晰、模糊和细节分配"
        },
        "lighting": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/light"
          },
          "description": "逐光源照明方案，覆盖主体受光及环境对象的照明来源。"
        },
        "color": {
          "type": "string",
          "description": "色调、明暗层次与氛围"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          },
          "description": "该镜头素材取舍"
        }
      },
      "required": [
        "id",
        "subject",
        "space",
        "camera",
        "focus",
        "lighting",
        "color",
        "elements"
      ],
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "description": "构图子任务产物，完成不等于已获确认",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "材料路径或原文来源"
          },
          "description": "原始材料依据"
        },
        "character_understanding": {
          "type": "string",
          "description": "性格、片段意义、当下意图、内外表现及材料依据"
        },
        "moment": {
          "type": "string",
          "description": "选定瞬间及理由"
        },
        "core_goal": {
          "type": "string",
          "description": "观者应理解的处境或关系及先后关注"
        },
        "atmosphere": {
          "type": "string",
          "description": "氛围与人物经历的联系"
        },
        "shots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shot"
          },
          "description": "构图设计"
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterion"
          },
          "description": "验收判据"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "会改变方向的待确认分歧"
          },
          "description": "提交用户的问题"
        },
        "confirmation_draft": {
          "type": "string",
          "description": "供主 Agent 转交用户的确认稿"
        },
        "first_trial": {
          "type": "object",
          "description": "用户报告已有图片问题时填写的首轮对照方案",
          "properties": {
            "reported_problem": {
              "type": "string",
              "description": "用户报告的问题，区分未观察的假设"
            },
            "hypothesis": {
              "type": "string",
              "description": "首轮唯一待检验原因"
            },
            "change": {
              "type": "string",
              "description": "围绕该原因的最小改动"
            },
            "keep": {
              "type": "string",
              "description": "对照中保持不变的关系、构图与参数"
            },
            "adopt_checks": {
              "type": "string",
              "description": "采用所需可见改善与保留条件"
            },
            "revert_checks": {
              "type": "string",
              "description": "无改善或损害必需项时的回退判据"
            },
            "missing_inputs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "建立可比基线尚缺的真实输入"
            }
          },
          "required": [
            "reported_problem",
            "hypothesis",
            "change",
            "keep",
            "adopt_checks",
            "revert_checks",
            "missing_inputs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "sources",
        "character_understanding",
        "moment",
        "core_goal",
        "atmosphere",
        "shots",
        "criteria",
        "questions",
        "confirmation_draft"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "description": "本任务有效配置；数值来源为 defaults.json 与用户覆盖，结构本身不设运行默认值",
      "properties": {
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "description": "每候选批计划图数"
        },
        "max_submissions": {
          "type": "integer",
          "minimum": 1,
          "description": "总提交调用额度"
        },
        "stagnation_rounds": {
          "type": "integer",
          "minimum": 1,
          "description": "同方向连续无改善上限"
        },
        "revalidation_batches": {
          "type": "integer",
          "minimum": 1,
          "description": "逐配置复验批次数"
        },
        "revalidation_images_per_batch": {
          "type": "integer",
          "minimum": 1,
          "description": "每批复验图数"
        },
        "delivery_per_shot": {
          "type": "integer",
          "minimum": 1,
          "description": "每镜头交付图数"
        },
        "revalidation_min_passed": {
          "type": "integer",
          "minimum": 1,
          "description": "未指定比例时每批最低联合通过张数"
        },
        "required_joint_ratio": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "用户指定的逐批联合通过比例；null使用最低张数"
            },
            {
              "type": "null"
            }
          ]
        },
        "media_poll_interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "无图片时的只读查询间隔"
        },
        "media_max_queries_per_stage": {
          "type": "integer",
          "minimum": 1,
          "description": "每阶段每组 Run 的媒体查询次数上限"
        }
      },
      "required": [
        "batch_size",
        "max_submissions",
        "stagnation_rounds",
        "revalidation_batches",
        "revalidation_images_per_batch",
        "delivery_per_shot",
        "revalidation_min_passed",
        "required_joint_ratio",
        "media_poll_interval_seconds",
        "media_max_queries_per_stage"
      ],
      "additionalProperties": false
    },
    "confirmation": {
      "type": "object",
      "description": "用户确认；由主 Agent 保存",
      "properties": {
        "text": {
          "type": "string",
          "description": "用户真实确认原文"
        },
        "source": {
          "type": "string",
          "description": "用户消息来源或可追溯标识"
        },
        "confirmed_at": {
          "type": "string",
          "description": "实际确认时间"
        }
      },
      "required": [
        "text",
        "source",
        "confirmed_at"
      ],
      "additionalProperties": false
    },
    "stage_index": {
      "type": "object",
      "description": "主 Agent 保存的阶段索引",
      "properties": {
        "id": {
          "type": "string",
          "description": "阶段ID"
        },
        "kind": {
          "type": "string",
          "enum": [
            "design",
            "confirm",
            "config",
            "prompt",
            "prompt_check",
            "generate",
            "query",
            "observe",
            "compare",
            "diagnose",
            "focus_observe",
            "revalidate",
            "archive",
            "wait",
            "stop",
            "finish"
          ],
          "description": "阶段类型"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "completed",
            "needs_input",
            "failed",
            "partial"
          ],
          "description": "阶段状态"
        },
        "input_path": {
          "type": "string",
          "description": "相对任务根目录的文件路径"
        },
        "prompt_path": {
          "type": "string",
          "description": "相对任务根目录的文件路径"
        },
        "result_path": {
          "type": "string",
          "description": "相对任务根目录的文件路径"
        },
        "reserved": {
          "type": "integer",
          "minimum": 0,
          "description": "本阶段预留提交次数"
        },
        "consumed": {
          "type": "integer",
          "minimum": 0,
          "description": "核对后已调用次数，包含 unknown"
        },
        "reserved_unknown": {
          "type": "integer",
          "minimum": 0,
          "description": "consumed中未知结果次数，不另扣"
        },
        "summary": {
          "type": "string",
          "description": "进度摘要"
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "input_path",
        "prompt_path",
        "result_path",
        "reserved",
        "consumed",
        "reserved_unknown",
        "summary"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "description": "主 Agent 唯一写入的任务状态",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "task_id": {
          "type": "string",
          "description": "任务名称或编号"
        },
        "status": {
          "type": "string",
          "enum": [
            "awaiting_confirmation",
            "running",
            "waiting",
            "paused",
            "completed",
            "unfinished",
            "stopped"
          ],
          "description": "awaiting_confirmation：等待用户确认构图或采用；running：阶段正在执行；waiting：等待已有 Run 的媒体可读；paused：缺少输入、工具或需用户处理的问题，暂不推进；completed、unfinished、stopped 的含义见 selection.status，归档后主 Agent 将任务状态设为该归档状态。"
        },
        "request": {
          "type": "string",
          "description": "用户原始需求"
        },
        "settings": {
          "$ref": "#/$defs/settings"
        },
        "selections": {
          "type": "object",
          "description": "用户或当前选择的 template_id、model_id、instance_id、loras 及各项来源，保留原始上下文"
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "不可变设计引用与确认",
            "properties": {
              "version": {
                "type": "string",
                "description": "目标版本"
              },
              "design_path": {
                "type": "string",
                "description": "相对任务根目录的文件路径"
              },
              "confirmation": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/confirmation"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "version",
              "design_path",
              "confirmation"
            ],
            "additionalProperties": false
          },
          "description": "目标版本"
        },
        "current_goal": {
          "anyOf": [
            {
              "type": "string",
              "description": "当前目标版本"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_by_shot": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "description": "相对任务根目录的文件路径"
          },
          "description": "镜头ID到当前采用配置记录的引用"
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage_index"
          },
          "description": "阶段索引"
        },
        "next_action": {
          "type": "string",
          "enum": [
            "design",
            "confirm",
            "config",
            "prompt",
            "prompt_check",
            "generate",
            "query",
            "observe",
            "compare",
            "diagnose",
            "focus_observe",
            "revalidate",
            "archive",
            "wait",
            "stop",
            "finish"
          ],
          "description": "下一调度动作"
        },
        "final_selection_path": {
          "anyOf": [
            {
              "type": "string",
              "description": "相对任务根目录的文件路径"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/confirmation"
            },
            {
              "type": "null"
            }
          ]
        },
        "autonomous_selection_authorization": {
          "anyOf": [
            {
              "type": "string",
              "description": "用户明确自主选图授权原文"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "status",
        "request",
        "settings",
        "selections",
        "goals",
        "current_goal",
        "baseline_by_shot",
        "stages",
        "next_action",
        "final_selection_path",
        "user_selection",
        "autonomous_selection_authorization"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "description": "阶段产物引用",
      "properties": {
        "path": {
          "type": "string",
          "description": "相对任务根目录的文件路径"
        },
        "purpose": {
          "type": "string",
          "description": "文件用途"
        }
      },
      "required": [
        "path",
        "purpose"
      ],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "description": "阶段问题",
      "properties": {
        "code": {
          "type": "string",
          "description": "实际错误码或具体问题类别"
        },
        "message": {
          "type": "string",
          "description": "问题与影响"
        },
        "affected_items": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "项目ID或路径"
          },
          "description": "受影响项目"
        }
      },
      "required": [
        "code",
        "message",
        "affected_items"
      ],
      "additionalProperties": false
    },
    "stage_input": {
      "type": "object",
      "description": "委派输入",
      "properties": {
        "stage_id": {
          "type": "string",
          "description": "阶段ID"
        },
        "kind": {
          "type": "string",
          "enum": [
            "design",
            "confirm",
            "config",
            "prompt",
            "prompt_check",
            "generate",
            "query",
            "observe",
            "compare",
            "diagnose",
            "focus_observe",
            "revalidate",
            "archive",
            "wait",
            "stop",
            "finish"
          ],
          "description": "当前阶段"
        },
        "goal_version": {
          "anyOf": [
            {
              "type": "string",
              "description": "目标版本"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "输入说明",
            "properties": {
              "path_or_text": {
                "type": "string",
                "description": "文件路径或当前消息原文"
              },
              "format": {
                "type": "string",
                "description": "文本、图片路径、JSON或stdout封装"
              },
              "purpose": {
                "type": "string",
                "description": "用途与来源"
              },
              "property": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "需要读取的具体JSON属性"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "path_or_text",
              "format",
              "purpose",
              "property"
            ],
            "additionalProperties": false
          },
          "description": "本阶段输入"
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "相对任务根目录的文件路径"
          },
          "description": "允许写入的任务文件"
        },
        "allowance": {
          "type": "integer",
          "minimum": 0,
          "description": "本阶段预留提交次数"
        },
        "data": {
          "type": "object",
          "description": "本阶段使用的具体输入数据；主 Agent 在委派消息中同时附上子 Agent 必须直接读取的内容。"
        }
      },
      "required": [
        "stage_id",
        "kind",
        "goal_version",
        "sources",
        "allowed_paths",
        "allowance",
        "data"
      ],
      "additionalProperties": false
    },
    "stage_result": {
      "type": "object",
      "description": "所有子任务共同结果；完整业务数据通过 artifacts 引用",
      "properties": {
        "stage_id": {
          "type": "string",
          "description": "阶段ID"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "needs_input",
            "failed",
            "partial"
          ],
          "description": "阶段完成状态"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "description": "完整业务产物引用"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          },
          "description": "缺项和错误"
        },
        "summary": {
          "type": "string",
          "description": "供主 Agent 使用的简短结论"
        },
        "next_action": {
          "type": "string",
          "enum": [
            "design",
            "confirm",
            "config",
            "prompt",
            "prompt_check",
            "generate",
            "query",
            "observe",
            "compare",
            "diagnose",
            "focus_observe",
            "revalidate",
            "archive",
            "wait",
            "stop",
            "finish"
          ],
          "description": "建议下一阶段"
        },
        "consumed": {
          "type": "integer",
          "minimum": 0,
          "description": "本阶段实际提交次数；非生成阶段为0"
        },
        "reserved_unknown": {
          "type": "integer",
          "minimum": 0,
          "description": "consumed中结果不明次数，不另扣减"
        },
        "budget_reconciliation": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "恢复额度核对",
            "properties": {
              "stage_id": {
                "type": "string",
                "description": "被核对的生成阶段ID"
              },
              "consumed": {
                "type": "integer",
                "minimum": 0,
                "description": "从逐调用记录确认的总调用次数"
              },
              "reserved_unknown": {
                "type": "integer",
                "minimum": 0,
                "description": "其中 unknown 数量"
              },
              "unused": {
                "type": "integer",
                "minimum": 0,
                "description": "确认未调用的预留数量"
              }
            },
            "required": [
              "stage_id",
              "consumed",
              "reserved_unknown",
              "unused"
            ],
            "additionalProperties": false
          },
          "description": "查询阶段恢复时填写；其他阶段为空数组"
        }
      },
      "required": [
        "stage_id",
        "status",
        "artifacts",
        "issues",
        "summary",
        "next_action",
        "consumed",
        "reserved_unknown",
        "budget_reconciliation"
      ],
      "additionalProperties": false
    },
