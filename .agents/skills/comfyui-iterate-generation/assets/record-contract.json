    "run": {
      "type": "object",
      "description": "生成子任务写提交，后续查询子任务按顺序追加查询与媒体",
      "properties": {
        "request_path": {
          "type": "string",
          "description": "相对任务根目录的文件路径"
        },
        "stage_id": {
          "type": "string",
          "description": "生成阶段ID"
        },
        "submission_status": {
          "type": "string",
          "enum": [
            "prepared",
            "submitting",
            "accepted",
            "rejected",
            "unknown"
          ],
          "description": "prepared：请求已保存但尚未安排调用；submitting：调用前记录已写，调用可能正在执行或中断，单凭此状态不能证明已调用；accepted：真实回执给出 Run ID；rejected：实际调用明确返回未创建 Run 的错误；unknown：核对后仍不能确定是否调用或是否受理。仅表示提交证据，不表示图片完成。"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string",
              "description": "实际回执Run ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "调用前建立的一次尝试记录，重试另记；consumed 只计已确认发生的调用，受理结果未知也计入。尚不能确认是否调用时保留阶段预留额度并记录无法结算原因，不能用 attempts 长度推算 consumed。",
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1,
                "description": "此请求调用序号"
              },
              "status": {
                "type": "string",
                "enum": [
                  "submitting",
                  "accepted",
                  "rejected",
                  "unknown"
                ],
                "description": "本次尝试的状态，证据条件与 submission_status 中同名状态一致。"
              },
              "run_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "实际Run ID"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "exit_code": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stdout_path": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "相对任务根目录的文件路径"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stderr_path": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "相对任务根目录的文件路径"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "number",
              "status",
              "run_id",
              "exit_code",
              "stdout_path",
              "stderr_path"
            ],
            "additionalProperties": false
          },
          "description": "提交调用记录"
        },
        "query_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "相对任务根目录的文件路径"
          },
          "description": "逐次原始查询"
        },
        "arguments_path": {
          "anyOf": [
            {
              "type": "string",
              "description": "相对任务根目录的文件路径"
            },
            {
              "type": "null"
            }
          ]
        },
        "workflow_path": {
          "anyOf": [
            {
              "type": "string",
              "description": "相对任务根目录的文件路径"
            },
            {
              "type": "null"
            }
          ]
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "图片来源与副本",
            "properties": {
              "media_id": {
                "type": "string",
                "description": "CLI实际媒体ID"
              },
              "source_path": {
                "type": "string",
                "description": "CLI实际本地绝对路径"
              },
              "copy_path": {
                "type": "string",
                "description": "相对任务根目录的文件路径"
              }
            },
            "required": [
              "media_id",
              "source_path",
              "copy_path"
            ],
            "additionalProperties": false
          },
          "description": "媒体"
        },
        "availability": {
          "type": "string",
          "enum": [
            "not_queried",
            "no_saved_image",
            "image_available",
            "query_error"
          ],
          "description": "查询可证明的状态，不推测Run完整运行状态"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          },
          "description": "保留实际错误"
        }
      },
      "required": [
        "request_path",
        "stage_id",
        "submission_status",
        "run_id",
        "attempts",
        "query_paths",
        "arguments_path",
        "workflow_path",
        "media",
        "availability",
        "errors"
      ],
      "additionalProperties": false
    },
