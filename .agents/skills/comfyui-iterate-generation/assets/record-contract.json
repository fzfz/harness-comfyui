    "selection": {
      "type": "object",
      "description": "归档子 Agent 保存的交付与未完成记录",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "unfinished",
            "stopped"
          ],
          "description": "completed：逐镜头交付数量及复验达标，且已有真实采用记录或自主选图授权支持最终选择；unfinished：预算、停滞或未解决错误使交付未完成；stopped：用户明确终止任务。"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "交付图片",
            "properties": {
              "shot_id": {
                "type": "string",
                "description": "镜头ID"
              },
              "media_path": {
                "type": "string",
                "description": "相对任务根目录的文件路径"
              },
              "request_path": {
                "type": "string",
                "description": "相对任务根目录的文件路径"
              },
              "run_id": {
                "type": "string",
                "description": "实际Run ID"
              },
              "review_path": {
                "type": "string",
                "description": "相对任务根目录的文件路径"
              },
              "revalidation_path": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "相对任务根目录的文件路径"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "shot_id",
              "media_path",
              "request_path",
              "run_id",
              "review_path",
              "revalidation_path"
            ],
            "additionalProperties": false
          },
          "description": "最终选图或已有候选"
        },
        "adoption": {
          "anyOf": [
            {
              "$ref": "#/$defs/confirmation"
            },
            {
              "type": "null"
            }
          ]
        },
        "autonomous_authorization": {
          "anyOf": [
            {
              "type": "string",
              "description": "用户授权原文"
            },
            {
              "type": "null"
            }
          ]
        },
        "revalidation": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_completed"
          ],
          "description": "只汇总 images 引用的配置及镜头：任一对应复验失败为 failed；无失败但有未完成或缺少复验记录，或 images 为空，为 not_completed；全部对应配置及镜头均按各批要求通过，才为 passed。"
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "未解决项"
          }
        },
        "stop_reason": {
          "anyOf": [
            {
              "type": "string",
              "description": "停止或未完成原因"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "images",
        "adoption",
        "autonomous_authorization",
        "revalidation",
        "unresolved",
        "stop_reason"
      ],
      "additionalProperties": false
    },
    "light": {
      "type": "object",
      "description": "一个实际拟用光源的设计；主光、补光、轮廓光及环境光分别记录。",
