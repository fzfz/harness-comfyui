{
  "name": "harness-comfyui",
  "version": "0.37.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "check:harness-boundary": "node scripts/security/check-harness-boundary.mjs",
    "check:manifest-lock": "node scripts/security/check-manifest-lock.mjs",
    "security:advisories": "node scripts/security/audit-lockfile.mjs",
    "security:build-scripts": "node scripts/security/check-build-scripts.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run tests/unit tests/integration --coverage --testTimeout=30000",
    "test:contract": "vitest run tests/contract tests/security",
    "test:integration": "vitest run tests/integration",
    "test:desktop": "vitest run tests/desktop --maxWorkers=1 --no-file-parallelism --testTimeout=120000",
    "test:prototype": "node --test prototype/generation-workbench/tests/*.test.mjs prototype/media-viewer-navigation/tests/*.test.mjs",
    "verify:comfyui-workflows": "node --experimental-strip-types scripts/verification/comfyui-workflow-matrix.mjs",
    "quality:preinstall": "pnpm run check:manifest-lock && pnpm run security:advisories && pnpm run security:build-scripts",
    "quality:fast": "pnpm run check:harness-boundary && pnpm run typecheck && pnpm run test:coverage && pnpm run test:contract && pnpm run prod:test && pnpm run test:prototype",
    "quality": "pnpm run quality:preinstall && pnpm run quality:fast && pnpm run test:desktop",
    "prod:start": "node scripts/desktop/production-cli.mjs start",
    "prod:stop": "node scripts/desktop/production-cli.mjs stop",
    "prod:restart": "node scripts/desktop/production-cli.mjs restart",
    "prod:status": "node scripts/desktop/production-cli.mjs status",
    "prod:logs": "node scripts/desktop/production-cli.mjs logs",
    "dev:start": "node scripts/desktop/cli.mjs start",
    "dev:stop": "node scripts/desktop/cli.mjs stop",
    "dev:restart": "node scripts/desktop/cli.mjs restart",
    "dev:status": "node scripts/desktop/cli.mjs status",
    "dev:logs": "node scripts/desktop/cli.mjs logs",
    "web:start": "node scripts/worktree/cli.mjs start",
    "web:stop": "node scripts/worktree/cli.mjs stop",
    "web:restart": "node scripts/worktree/cli.mjs restart",
    "web:status": "node scripts/worktree/cli.mjs status",
    "web:health": "node scripts/worktree/cli.mjs health",
    "web:logs": "node scripts/worktree/cli.mjs logs",
    "desktop:dependencies:link": "node scripts/desktop/dependencies.mjs",
    "prod:test": "vitest run tests/production --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "@vitest/coverage-v8": "4.1.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-attachment": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-input-trigger": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-jobs": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-workspace": ">=0.1.2-alpha.1 <0.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-api-remotes": { "optional": true },
    "@deepseek-ai/dsh-attachment": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true },
    "@deepseek-ai/dsh-client-ui-input-trigger": { "optional": true },
    "@deepseek-ai/dsh-client-ui-layout": { "optional": true },
    "@deepseek-ai/dsh-client-ui-primitives": { "optional": true },
    "@deepseek-ai/dsh-client-ui-sidebar": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-invariants": { "optional": true },
    "@deepseek-ai/dsh-jobs": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true },
    "@deepseek-ai/dsh-workspace": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./.local/source-client/client.js"
    },
    "./package.json": "./package.json"
  }
}
