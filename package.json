{
  "name": "harness-comfyui",
  "version": "0.45.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "check:harness-boundary": "node scripts/security/check-harness-boundary.mjs",
    "check:manifest-lock": "node scripts/security/check-manifest-lock.mjs",
    "security:advisories": "node scripts/security/audit-lockfile.mjs",
    "security:build-scripts": "node scripts/security/check-build-scripts.mjs",
    "build": "node scripts/build/cli.mjs build",
    "pack:plugin": "node scripts/build/cli.mjs pack",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit tests/skills",
    "test:coverage": "vitest run tests/unit tests/integration tests/skills --coverage --testTimeout=30000",
    "test:contract": "vitest run tests/contract tests/security",
    "test:integration": "vitest run tests/integration",
    "test:desktop": "node tests/desktop/run-desktop-tests.mjs",
    "test:prototype": "node --test prototype/generation-workbench/tests/*.test.mjs prototype/media-viewer-navigation/tests/*.test.mjs",
    "verify:comfyui-workflows": "node --experimental-strip-types scripts/verification/comfyui-workflow-matrix.mjs",
    "quality:preinstall": "pnpm run check:manifest-lock && pnpm run security:advisories && pnpm run security:build-scripts",
    "quality:fast": "pnpm run check:harness-boundary && pnpm run typecheck && pnpm run test:coverage && pnpm run test:contract && pnpm run test:production && pnpm run test:prototype",
    "quality": "pnpm run quality:preinstall && pnpm run quality:fast && pnpm run test:desktop",
    "test:production": "vitest run tests/production --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "@vitest/coverage-v8": "4.1.11",
    "js-yaml": "4.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "undici": "8.11.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
