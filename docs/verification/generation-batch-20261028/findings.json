        "description": "Create one durable ComfyUI Generation Run from one approved template, an optional resolved generation model, explicit runtime parameters, resolved LoRA selections, and an optional safe instance route; return the accepted run_id without waiting for remote completion.",
        "parameters": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Title shown for this Generation Run."
            },
            "instance_id": {
              "type": "string",
              "description": "Approved ComfyUI instance identity."
            },
            "template_id": {
              "type": "string",
              "description": "Approved ComfyUI template identity."
            },
            "model": {
              "type": "object",
              "description": "Generation model resolved by query_semantic_generation_models; the Host replaces the template default model with this model on the target ComfyUI instance.",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Resolved generation-model catalog identity."
                },
                "file_name": {
                  "type": "string",
                  "description": "Resolved catalog file name; the Host maps it to the target instance path."
                }
              },
              "required": [
                "id",
                "file_name"
              ]
            },
            "parameters": {
              "type": "object",
              "description": "Explicit Workflow runtime values. Standard semantic keys include positive_prompt, negative_prompt, width, height, seed, cfg, steps, sampler_name, scheduler, denoise, batch_size, resolution_preset, reference_image, aspect_ratio, megapixels. An exact user-supplied Workflow input key is also accepted. The Host resolves every supplied key against the executable Workflow and the target ComfyUI instance.",
              "additionalProperties": true
            },
            "loras": {
              "type": "array",
              "description": "LoRAs resolved by query_semantic_loras and applied to the current Workflow through the target ComfyUI instance node definitions.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Resolved LoRA catalog identity."
                  },
                  "file_name": {
                    "type": "string",
                    "description": "Resolved catalog file name; the Host maps it to the target instance path."
                  },
                  "weight": {
                    "type": "number",
                    "description": "Model weight selected for this LoRA."
                  },
                  "trigger_words": {
                    "type": "array",
                    "description": "Trigger words actually used in the rewritten final prompt.",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "id",
                  "file_name",
                  "weight",
                  "trigger_words"
                ]
              }
            }
          },
          "required": [
