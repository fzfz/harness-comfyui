# 把本文件复制为主开发 checkout 或生产 checkout 根目录中的 `.env`。
# linked worktree 的 `dev:start` 和 `web:start` 会链接主开发 checkout 的同一份 `.env`，不要在 worktree 复制第二份。

# `opencode-go` Provider 使用此 API Key。默认 Agent 模型和默认视觉模型都使用该 Provider。
OPENCODE_GO_API_KEY=replace-with-opencode-go-api-key

# 生产 checkout 的 DSH Desktop 移动桥接监听端口。
# `pnpm dev:start` 为每个 linked worktree 自动分配端口，不读取本变量作为开发端口。
# COMFYUI_WORKBENCH_DESKTOP_MOBILE_BRIDGE_PORT=43127

# 以下 Harness ComfyUI 配置都有仓库默认值。删除行首的 `# ` 后可以覆盖对应默认值。

# 默认 ComfyUI 实例 ID；该 ID 必须已经登记在当前 Harness 配置中。
# HARNESS_COMFYUI_DEFAULT_INSTANCE_ID=1

# Official API Workflow 编译器使用的 Chrome 或 Chromium 可执行文件绝对路径。
# HARNESS_COMFYUI_FRONTEND_BROWSER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Workflow 编译缓存代次。ComfyUI 前端或影响序列化的节点升级后递增该值。
# HARNESS_COMFYUI_FRONTEND_CACHE_EPOCH=1

# Chrome DevTools 连接、页面初始化和 graphToPrompt() 导出的统一超时，单位为毫秒。
# HARNESS_COMFYUI_FRONTEND_COMPILER_TIMEOUT_MS=120000

# 本机浏览器发布 DevToolsActivePort 的阶段超时，单位为毫秒。
# HARNESS_COMFYUI_FRONTEND_DEVTOOLS_PORT_TIMEOUT_MS=10000

# 本机 Chrome DevTools HTTP 接口创建页面目标的阶段超时，单位为毫秒。
# HARNESS_COMFYUI_FRONTEND_TARGET_CREATE_TIMEOUT_MS=10000

# Harness Host 连接本机浏览器目标 WebSocket 的阶段超时，单位为毫秒。
# HARNESS_COMFYUI_FRONTEND_WEBSOCKET_CONNECT_TIMEOUT_MS=10000

# 本机浏览器目标启用 Chrome DevTools 调试域的阶段超时，单位为毫秒。
# HARNESS_COMFYUI_FRONTEND_DOMAIN_ENABLE_TIMEOUT_MS=10000

# 本机浏览器目标执行 Page.navigate 的阶段超时，单位为毫秒。
# HARNESS_COMFYUI_FRONTEND_NAVIGATION_TIMEOUT_MS=10000

# 前端就绪前基础设施故障的浏览器尝试次数，只允许 1 或 2。
# HARNESS_COMFYUI_FRONTEND_INFRASTRUCTURE_ATTEMPTS=2

# Client 查询 Generation Run 状态的刷新间隔，单位为毫秒。
# HARNESS_COMFYUI_CLIENT_RUN_REFRESH_INTERVAL_MS=1000

# 单个 ComfyUI 输出媒体允许保存的最大字节数；示例值为 512 MiB。
# HARNESS_COMFYUI_MEDIA_MAX_FILE_BYTES=536870912

# Harness Web Host 的显式监听端口。linked worktree 的 `pnpm web:start` 和 `pnpm web:restart` 会忽略本变量并自动分配端口。
# DSH Desktop 的 Harness 端口由 Desktop 动态分配；`pnpm dev:*` 和 `pnpm prod:*` 不读取本变量作为 Desktop 端口。
# HARNESS_COMFYUI_SERVER_PORT=4173

# 以下可配置项不使用环境变量：
# - Desktop 默认 Workspace：config/desktop-production.json 的 startupWorkspacePath。
# - Web Host 默认 Workspace：config/web-development.json 的 startupWorkspacePath。
# - Desktop 源码目录、生产 runtime 和环境文件路径：config/desktop-production.json。
# - linked worktree 的主 checkout 和开发 runtime：config/desktop-worktree.json。
# - 数据源服务 URL 和端口：DSH Desktop“设置 -> ComfyUI -> 数据源服务”；config/source-production.json 只提供默认端口。
# - 图片读取的 OpenAI 兼容接口地址、模型和 API Key：DSH Desktop“设置 -> ComfyUI -> 图片读取”。
