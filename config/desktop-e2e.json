{
  "schemaVersion": 1,
  "modes": {
    "defaultMode": "fresh",
    "fresh": {
      "persistent": false
    },
    "development": {
      "persistent": true,
      "environmentRootRelativePath": ".local/desktop-development/official-environment",
      "environmentFilePath": "/Volumes/4Tdisk/work/AI2/harness-comfyui/.env",
      "credentialEnvironmentNames": [
        "LAN_GPT_API_KEY",
        "OPENROUTER_API_KEY",
        "OPENCODE_GO_API_KEY",
        "NOOBAI_MCP_TOKEN"
      ],
      "requiredEnvironmentNames": [
        "LAN_GPT_API_KEY"
      ],
      "initialProfilePatches": [
        {
          "id": "agent-default-model",
          "config": {
            "provider": "lan-gpt",
            "model": "gpt-6.1-sol",
            "reasoningEffort": "high"
          }
        },
        {
          "id": "llm-pi-ai",
          "config": {
            "providers": {
              "lan-gpt": {
                "displayName": "LAN GPT",
                "api": "openai-completions",
                "baseURL": "http://192.168.110.16:8317/v1",
                "apiKeyEnv": "LAN_GPT_API_KEY",
                "reasoning": "high",
                "models": [
                  {
                    "id": "gpt-6.1-sol",
                    "input": [
                      "text",
                      "image"
                    ],
                    "reasoningEfforts": {
                      "high": "high"
                    }
                  }
                ]
              },
              "openrouter": {
                "displayName": "OpenRouter",
                "api": "openai-completions",
                "baseURL": "https://openrouter.ai/api/v1",
                "apiKeyEnv": "OPENROUTER_API_KEY",
                "models": [
                  {
                    "id": "thinkingmachines/inkling:free",
                    "input": [
                      "text",
                      "image"
                    ],
                    "contextWindow": 1048576,
                    "maxTokens": 8192
                  }
                ]
              }
            }
          }
        }
      ],
      "directoryNames": {
        "dshHome": "dsh-home",
        "electronUserData": "user-data",
        "workspace": "workspace"
      },
      "leaseFilename": "active-probe.json"
    }
  },
  "application": {
    "bundlePath": "/Applications/DeepSeek Harness.app",
    "executableRelativePath": "Contents/MacOS/DeepSeek Harness",
    "bundleId": "com.deepseek.dsh",
    "version": "0.2.1-rc.3"
  },
  "paths": {
    "runRootRelativePath": ".local/desktop-e2e",
    "directoryNames": {
      "dshHome": "dsh-home",
      "electronUserData": "user-data",
      "workspace": "workspace",
      "logs": "logs",
      "evidence": "evidence"
    },
    "profileRelativePath": "profiles/desktop",
    "profilePatchFilename": "cordis.patch.yml",
    "runRecordFilename": "run.json",
    "diagnosticFilename": "diagnostic.log",
    "outputFilenames": {
      "stdoutLog": "desktop.stdout.log",
      "stderrLog": "desktop.stderr.log",
      "startupReadyEvidence": "startup-ready.json",
      "preparationFailureEvidence": "preparation-failure.json",
      "failureEvidence": "failure.json",
      "cleanupFailureEvidence": "cleanup-failure.json",
      "stopRequestEvidence": "stop-request.json",
      "stopResultEvidence": "stop-result.json"
    }
  },
  "ports": {
    "allocation": "held-loopback-ephemeral",
    "host": "127.0.0.1",
    "roles": [
      "host",
      "rendererCdp",
      "hostInspector"
    ],
    "requiredForReady": [
      "host",
      "rendererCdp"
    ]
  },
  "startup": {
    "startupTimeoutMs": 60000,
    "portReadyTimeoutMs": 45000,
    "singleInstanceExitWindowMs": 12000,
    "stopTimeoutMs": 5000,
    "killTimeoutMs": 5000,
    "pollIntervalMs": 100
  },
  "rendererCdp": {
    "maxPayloadSize": 67108864
  },
  "readiness": {
    "rendererTargetTitle": "DeepSeek Harness",
    "rendererSessionTitleSeparator": " — ",
    "applicationUrlPrefix": "dsh-app://",
    "documentReadyState": "complete",
    "requireVisibleBodyText": true
  },
  "invocation": {
    "environmentNames": {
      "dshHome": "DSH_HOME",
      "electronUserData": "DSH_DESKTOP_USER_DATA_DIR",
      "diagnosticFile": "DSH_DESKTOP_DIAGNOSTIC_FILE",
      "hostInspectorPort": "DSH_DESKTOP_HOST_INSPECT_PORT"
    },
    "unsetEnvironmentNames": [
      "ELECTRON_RUN_AS_NODE"
    ],
    "arguments": [
      "--user-data-dir={electronUserData}",
      "--remote-debugging-port={rendererCdpPort}",
      "--remote-debugging-address={loopbackHost}"
    ]
  },
  "profilePortPatch": {
    "entryId": "webserver",
    "hostField": "host",
    "portField": "port"
  },
  "capabilities": {
    "defaultApplicationLogsIsolated": false,
    "applicationHostHealthVerified": false,
    "pluginIdentityVerified": false
  },
  "sessionTrace": {
    "directoryName": "session-trace",
    "filenames": {
      "sessionsDirectory": "sessions",
      "session": "session.json",
      "index": "trace-index.json"
    },
    "export": {
      "route": "api/session.export",
      "sessionLogFilename": "session.v4.jsonl"
    }
  },
  "rawCapture": {
    "filenames": {
      "index": "raw-capture-index.json",
      "state": "raw-capture-state.json",
      "requests": "requests",
      "requestBody": "request.bin",
      "responseBody": "response.bin",
      "requestMetadata": "request.json",
      "sseIndex": "sse-index.json",
      "observations": "observations",
      "observerIndex": "observer-index.json",
      "profileRestoration": "profile-restoration.json",
      "spills": "spills"
    },
    "sensitiveHeaders": ["authorization", "proxy-authorization", "cookie", "set-cookie", "x-api-key", "api-key"],
    "hopHeaders": ["connection", "keep-alive", "proxy-authenticate", "proxy-authorization", "te", "trailer", "transfer-encoding", "upgrade"],
    "sessionHeaders": ["x-session-id", "x-dsh-session-id", "session-id"],
    "observer": {
      "entryId": "isolated-raw-trace-observer",
      "providerEntryId": "llm-pi-ai"
    }
  },
  "commandRunner": {
    "invocationDirectoryEnvironmentName": "HARNESS_COMFYUI_DESKTOP_TEST_INVOCATION_DIRECTORY",
    "invocationsRelativePath": ".local/desktop-e2e/desktop-test-runner/invocations",
    "descriptorDirectoryName": "runs",
    "invocationFilename": "invocation.json",
    "cancellationFilename": "cancel-request.json",
    "resultFilename": "cancellation-result.json",
    "pendingStartDrainTimeoutMs": 80000,
    "commandStopTimeoutMs": 5000,
    "commandKillTimeoutMs": 5000
  }
}
