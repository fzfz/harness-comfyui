{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-comfyui/source-contract-v0.84.0.json",
  "contractId": "imagegen-source-contract",
  "sourceReleaseVersion": "0.84.0",
  "identity": {
    "owner": "harness-comfyui",
    "source": "configuration.source",
    "notReadFromLiveResponse": true
  },
  "cli": {
    "catalog": {
      "name": "imagegen-semantic-query",
      "discoveryFlag": "--discovery-json",
      "queryArguments": ["--port", "--path", "--mode", "--query", "--page", "--page_size", "--id"]
    },
    "source": {
      "name": "imagegen-comfyui-source-read",
      "discoveryFlag": "--discovery-json",
      "queryArguments": ["--port", "instance", "template-bundle", "--id"]
    },
    "responseMode": "raw-passthrough",
    "successBody": {
      "encoding": "utf-8",
      "jsonValueCount": 1,
      "businessSchemaValidationOwner": "harness-adapter"
    },
    "exitCodes": {
      "success": 0,
      "invalidArguments": 2,
      "discoveryHttpError": 3,
      "connectionFailure": 4,
      "timeout": 5,
      "protocolBodyFailure": 6,
      "targetHttpFailure": 7,
      "sigint": 130,
      "sigterm": 143
    }
  },
  "envelope": {
    "success": {
      "required": ["status", "message", "results", "page", "page_size", "total_count"],
      "status": "ok",
      "message": null,
      "results": {"type": "array", "maxItems": 100},
      "page": {"type": "integer", "minimum": 1},
      "page_size": {"type": "integer", "minimum": 1, "maximum": 100},
      "total_count": {"type": "integer", "minimum": 0}
    },
    "error": {
      "required": ["status", "message", "results", "page", "page_size", "total_count"],
      "status": "error",
      "message": {"type": "string", "minLength": 1},
      "results": {"type": "array", "maxItems": 0},
      "page": 1,
      "page_size": 0,
      "total_count": 0
    }
  },
  "catalog": {
    "discovery": {
      "shape": "openapi-document",
      "openapi": "3.1.0",
      "requiredTopLevel": ["openapi", "info", "x-imagegen-media-origin", "paths", "components"],
      "forbiddenTopLevel": ["contract_id", "contract_version", "source_release_version"],
      "operationCount": 10
    },
    "operations": [
      {"tool": "query_semantic_base_models", "operationId": "querySemanticBaseModelsForSkill", "path": "/internal/semantic/base-models", "filters": []},
      {"tool": "query_semantic_generation_models", "operationId": "querySemanticGenerationModelsForSkill", "path": "/internal/semantic/generation-models", "filters": ["base_model_id"]},
      {"tool": "query_semantic_loras", "operationId": "querySemanticLorasForSkill", "path": "/internal/semantic/loras", "filters": ["base_model_id"]},
      {"tool": "query_semantic_works", "operationId": "querySemanticWorksForSkill", "path": "/internal/semantic/works", "filters": []},
      {"tool": "query_semantic_characters", "operationId": "querySemanticCharactersForSkill", "path": "/internal/semantic/characters", "filters": ["work_id"]},
      {"tool": "query_semantic_styles", "operationId": "querySemanticStylesForSkill", "path": "/internal/semantic/styles", "filters": ["base_model_id"]},
      {"tool": "query_semantic_prompt_terms", "operationId": "querySemanticPromptTermsForSkill", "path": "/internal/semantic/prompt-terms", "filters": []},
      {"tool": "query_semantic_artist_prompt_strings", "operationId": "querySemanticArtistPromptStringsForSkill", "path": "/internal/semantic/artist-prompt-strings", "filters": ["base_model_id"]},
      {"tool": "query_semantic_comfyui_instances", "operationId": "querySemanticComfyuiInstancesForSkill", "path": "/internal/semantic/comfyui-instances", "filters": []},
      {"tool": "query_semantic_comfyui_templates", "operationId": "querySemanticComfyuiTemplatesForSkill", "path": "/internal/semantic/comfyui-templates", "filters": ["base_model_id"]}
    ],
    "normalization": {
      "itemsFrom": "results",
      "sourceReleaseVersionFrom": "configuration.source.sourceReleaseVersion",
      "resultContractIdFrom": "catalog-operation-manifest",
      "resolveRequires": {"resultsLength": 1, "page": 1, "page_size": 1, "total_count": 1},
      "additionalRequiredResultFieldsByOperation": {
        "querySemanticGenerationModelsForSkill": ["sample_image_urls"],
        "querySemanticLorasForSkill": ["sample_image_urls"],
        "querySemanticWorksForSkill": ["sample_image_urls"],
        "querySemanticCharactersForSkill": ["sample_image_urls"],
        "querySemanticStylesForSkill": ["sample_image_urls"],
        "querySemanticPromptTermsForSkill": ["sample_image_urls"],
        "querySemanticArtistPromptStringsForSkill": ["sample_image_urls"],
        "querySemanticComfyuiTemplatesForSkill": ["sample_image_urls"]
      },
      "fieldMappings": {
        "sample_image_urls": {
          "target": "sampleImageUrls",
          "scope": "catalog-item-display",
          "includeInCatalogContext": false
        }
      }
    }
  },
  "source": {
    "discovery": {
      "shape": "catalog-source-envelope",
      "requiredTopLevel": ["status", "message", "results", "page", "page_size", "total_count"],
      "status": "ok",
      "openapiLocation": "results[0]",
      "openapi": "3.1.0",
      "resultsLength": 1
    },
    "operations": [
      {"operationId": "getComfyuiInstanceSourceForHost", "path": "/internal/comfyui-source/instances/{instance_id}", "command": "instance"},
      {"operationId": "getComfyuiTemplateBundleForHost", "path": "/internal/comfyui-source/templates/{template_id}/bundle", "command": "template-bundle"}
    ],
    "instanceNormalization": {
      "itemsFrom": "results",
      "requiredFields": ["id", "title", "url", "credential_type", "authorization"],
      "authorizationOwner": "host-process-memory",
      "persistedFields": ["id", "title", "credential_type"]
    },
    "templateBundleNormalization": {
      "itemsFrom": "results",
      "requiredResultFields": ["id", "title", "revision_number", "workflow_sha256", "workflow_json", "config_revision", "dimension_strategy", "parameters_json", "bindings_json", "expected_output_node_ids_json"],
      "mapping": {
        "id": "template_id",
        "revision_number": "workflow_revision",
        "workflow_json": "source_workflow",
        "config_revision": "runtime_config_revision",
        "parameters_json": "parameters",
        "bindings_json": "bindings",
        "expected_output_node_ids_json": "expected_output_node_ids"
      },
      "expectedOutputNodeIds": {"type": ["array", "null"], "arrayMinItems": 1, "nullBehavior": "discover-active-output-nodes-from-live-object-info"},
      "sourceRevision": {"valueFrom": "configuration.source.sourceReleaseVersion"}
    }
  }
}
