{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "lib/types",
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "config/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["node_modules", "lib", ".local", ".release", "prototype"]
}
